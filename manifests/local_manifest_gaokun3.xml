<?xml version="1.0" encoding="UTF-8"?>
<!--
  gaokun3 在 crDroid 16.0 树里的额外项目。

  用法（构建机上）：
      cp manifests/local_manifest_gaokun3.xml ~/crdroid/.repo/local_manifests/
      repo sync

  crDroid 16.0 的 manifest（1180 个项目）里【已经有】的，这里不重复列：
      device/generic/goldfish        LineageOS/android_device_generic_goldfish
                                    （WiFi HAL 用它的 libwifi-hal-emu）
      external/mesa3d               platform/external/mesa3d @ android-16.0.0_r4
                                    （= mesa 26.0.3，与我们打过补丁的快照同一版）
      external/minigbm              platform/external/minigbm
      external/drm_hwcomposer       platform/external/drm_hwcomposer
      external/deqp-deps/glslang    platform/external/deqp-deps/glslang
      vendor/lineage                crdroidandroid/android_vendor_crdroid
  以上均于 2026-08-19 用 `repo manifest -o -` 逐条核实。
-->
<manifest>
  <!--
    device/linaro/dragonboard —— 唯一需要补的项目。
    db845c 是树内唯一的"高通主线内核 + minigbm + drm_hwcomposer"参考设备，
    我们的 BoardConfig.mk 直接引用它两个 sepolicy 目录：
        shared/graphics/minigbm_msm/sepolicy
        shared/graphics/swangle/sepolicy
    crDroid/LineageOS 的 manifest 不带它（Lineage 不支持这类开发板）。

    remote="aosp" 继承 aosp remote 的 revision refs/tags/android-16.0.0_r4，
    已用 git ls-remote 验证该 tag 存在（685cd7ce06fd）。
  -->
  <project path="device/linaro/dragonboard" name="device/linaro/dragonboard"
           remote="aosp" />
  <!--
    external/hexagonrpc —— 传感器用。它给 SLPI 上的 DSP 当只读文件服务器
    （AP 侧没有到传感器芯片的总线，见 docs/stage4-findings.md #37）。

    ★ 上游【自带完整 Android 构建支持】，不用我们写 Android.bp：
        Android.bp                  cc_defaults "hexagonrpc_defaults"
        libhexagonrpc/Android.bp    共享库
        hexagonrpcd/Android.bp      cc_binary, vendor: true
        data/Android.bp             hexagonrpcd-sdsp.rc（service 跑 system:system，
                                    -R /vendor/etc/hexagonrpcd-root）
        include/Android.bp          cc_library_headers "hexagonrpc_headers"

    ⚠️ 两个必须自己补的集成点：
      1. hexagonrpc_defaults 里 header_libs 了 "device_kernel_headers" —— 那是
         约定由设备树提供的名字，树里没人定义。我们建了个空壳：
         device/huawei/gaokun3/kernel-headers/Android.bp。
         （不需要真提供内容：hexagonrpc 用到的 6 个 fastrpc ioctl 与 5 个 uapi
         struct，bionic 的 uapi/misc/fastrpc.h 里全有，2026-08-20 逐符号比对过。）
      2. 上游【没有】CR 截断补丁，缺了 DSP 读不到传感器注册表 →
         由 scripts/crdroid-tree-fixes.py 打（幂等）。

    revision 钉在实测通过的这个 commit（2026-08-13 "bump to version 0.5.0"）。
    上游若改动 copy_segment_and_advance()，tree-fixes 脚本会报"找不到锚点"
    而不是静默打歪 —— 那时再评估要不要跟进。
    许可证 GPL-3.0（装进 vendor 分区）。
  -->
  <project path="external/hexagonrpc" name="linux-msm/hexagonrpc"
           remote="github"
           revision="435ed1cd68e20f8a9fe4871233ed1f8ce7ccf9e8" />
</manifest>
