# init.gaokun3.rc -- Huawei MateBook E Go (sc8280xp)

on early-init
    # 本机没有串口，内核日志只能靠 dmesg / efi_pstore
    write /proc/sys/kernel/printk "7 4 1 7"

# ═════════ 挡住 s2idle 休眠（★M4 已定性：内核/EC 缺陷，与 Android 无关）═════════
# 症状：挂起后【永不 resume】，约 20–40 秒后整机被复位。默认启动项是 Ubuntu，
# 于是自动落到 Ubuntu —— 这既是安全网，也是我们唯一的远程救援通路。
#
# ★★ 2026-08-19 M4 的判决性实验（推翻了"Android 的挂起模型太激进"这一旧猜想）：
#   在【Ubuntu】里用同一棵内核源码做同样的一件事 —— 直接
#   `echo mem > /sys/power/state` —— 结果完全一样：写下去就再也没回来，
#   机器约 20 秒后复位。
#   证据：/home/user/suspend-test.log 停在 "写 /sys/power/state = mem" 那一行，
#   紧随其后的 "★ 走到这一行就说明 resume 成功了" 从未被写出；
#   机器回来后 `uptime` 显示是**全新启动**（不是 resume）。
#   → 与 Android、与 SystemSuspend、与我们的设备树【全都无关】，
#     是内核/EC 层面的缺陷。根治要往上游走，不在本项目范围内。
#
# 已排除的两个"看起来应该已经修好了"的因素（都在现役 kb23 内核里，实测仍然挂）：
#   - patches/upstream/0012：把 EC 的 PM 回调从 NOIRQ_SYSTEM_SLEEP_PM_OPS 换成
#     SYSTEM_SLEEP_PM_OPS。补丁说明原话就是修 "resume to fail silently"
#     —— NOIRQ 变体在 I2C 控制器已挂起后才跑，EC 握手不可能完成。
#   - patches/others/0017：给 EC 的 i2c client 加 device_init_wakeup(dev, true)。
#     实机佐证：/sys/class/wakeup/ 里确实有 15-0038（EC 的 i2c 地址）→ 这句在跑。
#   两个补丁都在，s2idle 照样醒不来。
#   ⚠️ 无法用 /sys/power/pm_test 做分层二分：本机内核没开 CONFIG_PM_DEBUG，
#      该节点不存在（Ubuntu 与 Android 两侧都不存在）。
#   ⚠️ 也拿不到挂起瞬间的日志：userspace 已冻结，journald 来不及落盘；
#      clean hang 不产生 panic，efi_pstore 同样抓不到（实测 pstore 里没有当日记录）。
#
# 为什么用内核 wakelock 而不是 `svc power stayon true`：
#   stayon 走 stay_on_while_plugged_in，只在【插电】时有效，而且它把**屏幕**也钉亮着；
#   /sys/power/wake_lock 是 CONFIG_PM_WAKELOCKS 的用户态接口，init 以 root 写入后
#   无条件阻止自动挂起，与供电状态无关，**而且不妨碍息屏**。
#   → 于是用户仍能得到"按电源键息屏、再按点亮"的正常体验，只是机器不真的睡。
#     这就是本机目前能提供的"待机"。
#
# ⚠️ 排查用的副作用（记一条，省下一次两小时的误诊）：
#   持有 wakelock 时读 /sys/power/wakeup_count 会【永久阻塞】（实测 cat 挂死 120s）。
#   Android 的 SystemSuspend 正是卡在这一读上，所以它连一次挂起都不会发起
#   —— /sys/power/suspend_stats/success 恒为 0。别在探测脚本里 cat 这个节点。
#
# ⚠️ 必须是 `on init` 而不是 `on early-init`：早期 sysfs 还没挂好，
#    2026-08-19 实测 early-init 写入静默失败。
on init
    write /sys/power/wake_lock gaokun3_nosuspend

# 逃生口：留给将来复测 s2idle（内核修好后一条属性就能放开，不必重编镜像）。
#   adb shell setprop persist.gaokun3.allow_suspend 1
# ⚠️ 现在设它 = 机器挂起后必然复位并落到 Ubuntu。只在你准备好做复现实验时才用。
on property:persist.gaokun3.allow_suspend=1
    write /sys/power/wake_unlock gaokun3_nosuspend

# ⚠️ 这里绝不能自己挂 binderfs —— AOSP 16 的 init.rc 已原生处理
# （挂 /dev/binderfs + 建 /dev/binder 等符号链接）。
# 再挂一次会创建【第二个】binderfs 实例盖在上面：每个 binderfs 挂载是
# 独立的 binder context，servicemanager 注册在旧实例上，之后的客户端
# 全落到新实例 —— "cannot find target node" 死循环，vdc 卡死启动。
# （内核侧 CONFIG_ANDROID_BINDERFS=y 时静态 binder 设备根本不注册，
#   见 drivers/android/binder.c binder_init 的 IS_ENABLED 判断。）
# 这是 aospm sdm845（Android 13 时代）模板的写法，16 上是事故源。
# 实测踩坑记录见 docs/stage2-findings.md 第 9 节。

# ⚠️ /vendor/etc/init/hw/ 不会被 init 自动扫描（自动扫的是 /vendor/etc/init/），
# 放这里的 rc 必须显式 import，否则静默不生效。实测后果：usb rc 从未运行，
# sys.usb.configfs 恒为 0，触发走 legacy android_usb 分支（主线内核无此 sysfs），
# gadget 永不绑 UDC。见 docs/stage2-findings.md 第 8.3quater 节。
import /vendor/etc/init/hw/init.gaokun3.usb.rc

# ⚠️ mount_all 必须由设备 rc 调用 —— AOSP 16 的 init.rc 自己不调
# （init.rc:511-520 注释明说 "Mount fstab in init.{$device}.rc by
#   mount_all command"）。缺了它 /data 永远不挂载：post-fs-data 的
#   mkdir 全打在只读 system 根的 /data 空目录上报 EROFS，
#   keystore2 因 /data/misc/keystore 不存在而崩溃循环。实测见
#   docs/stage2-findings.md 第 8.3bis 节。
on fs
    mount_all /vendor/etc/fstab.gaokun3 --early

on late-fs
    mount_all /vendor/etc/fstab.gaokun3 --late

on post-fs-data
    mkdir /data/vendor 0771 root root

# ath11k 内置驱动开机 5s 即 probe，/vendor 未挂载拿不到固件而永久放弃；
# vendor 挂载后（post-fs-data）手动补一次 bind。见 docs/stage4-findings.md #28
on post-fs-data
    write /sys/bus/pci/drivers/ath11k_pci/bind "0006:01:00.0"

# remoteproc 兜底：ramdisk 里已带固件，早期 probe 正常就已 running；
# 万一没起来（固件路径变动等），这里补一刀。ADSP 不起来就没有声卡。
on property:sys.boot_completed=1
    write /sys/class/remoteproc/remoteproc0/state start
    write /sys/class/remoteproc/remoteproc1/state start
    write /sys/class/remoteproc/remoteproc2/state start

# turnip 调试旗标（快速迭代机制 v3，见 docs/stage5-freedreno.md）：
# 内核 cmdline 加 androidboot.tu_debug=<flags> → ro.boot.tu_debug → 下面的属性。
# ⚠️ 属性名按 mesa src/util/os_misc.c os_get_android_option() 推导：
# TU_DEBUG 不以 MESA_ 开头 → 加 "mesa." 前缀 → 下划线转点+转小写
# → "mesa.tu.debug" → 依次试前缀 "debug." / "vendor." / ""。
# 所以必须是 debug.mesa.tu.debug —— 曾误写 debug.tu.debug，导致 2026-08-18
# 之前所有 tu_debug 实验的旗标从未生效（"旗标全部无罪"的旧结论因此作废）。
# cmdline 里没给时该命令失败，无副作用。
on post-fs-data
    setprop debug.mesa.tu.debug ${ro.boot.tu_debug}
