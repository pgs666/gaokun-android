# init.gaokun3.usb.rc -- USB gadget for Huawei MateBook E Go
#
# 分工（依据 AOSP 16 源码，不是猜的）：
#   system/core/rootdir/init.rc:217          已挂 configfs 到 /config
#   system/core/rootdir/init.usb.configfs.rc 处理所有属性触发、写 UDC、起 adbd
#   本文件                                    只负责搭 gadget 骨架 + 置 configfs=1
#
# UDC 名 a600000.usb 由 device.mk 的 sys.usb.controller 提供。
# [measured] Stage 1 在实机上验证过：该控制器能枚举到 configured，
# 主机端读得到文件系统；FunctionFS 也挂得起来。
# 前提是 DTS 里 usb_0_dwc3 已改成 dr_mode="otg" + usb-role-switch。

on post-fs-data
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb rmode=0770,fmode=0660,uid=2000,gid=2000,no_disconnect=1

on boot
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0x4EE7
    write /config/usb_gadget/g1/bcdDevice 0x0100
    write /config/usb_gadget/g1/bcdUSB 0x0200

    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}

    mkdir /config/usb_gadget/g1/functions/ffs.adb

    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500

    # 告诉通用脚本走 configfs 路线（默认 0 = 老的 android_usb 路线，本机没有）
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb
